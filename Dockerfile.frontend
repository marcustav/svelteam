# Marco 6 (item 41): o container do site usa o BUILD DE PRODUÇÃO, e não o npm run dev.

# Etapa 1: gera o site estático (pasta build/) com o compilador do Svelte.
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Lê o .env.production: o endereço da API fica escrito dentro do JavaScript.
RUN npm run build

# Etapa 2: só entrega os arquivos. Não tem Svelte, Vite nem node_modules do projeto.
FROM node:24-alpine
WORKDIR /app
RUN npm install -g sirv-cli@3.0.1 && npm cache clean --force
COPY --from=build /app/build ./build

ENV PORT=3000
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 3000), {signal: AbortSignal.timeout(4000)}).then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

# --single 200.html: qualquer rota (/tarefas/2, /quadro...) recebe a casca 200.html.
CMD ["sh", "-c", "exec sirv build --single 200.html --host 0.0.0.0 --port \"$PORT\""]
